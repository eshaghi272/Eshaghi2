# ===== محیط =====
.env
.env.local
.env.*.local
*.env

# ===== بک‌اند =====
backend/uploads/
backend/dist/
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# ===== فرانت‌اند =====
frontend/dist/
frontend/build/
frontend/.vite/
frontend/*.log

# ===== سیستم =====
.DS_Store
Thumbs.db
*.log

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== تنظیمات =====
*.iml
package-lock.json
yarn.lock